APP_NAME="Chamados Codificar API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=chamados
DB_USERNAME=chamados
DB_PASSWORD=chamados


BROADCAST_CONNECTION=reverb

REVERB_APP_ID=chamados
REVERB_APP_KEY=chamados-key
REVERB_APP_SECRET=chamados-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# Nao ha mais sessao web (API stateless com tokens); "file" evita
# dependencia de Redis so para isso.
SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=redis

QUEUE_CONNECTION=redis


REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="chamados@codificar.local"
MAIL_FROM_NAME="${APP_NAME}"

WS_BRIDGE_PORT=6001

# Origens (separadas por virgula) autorizadas via CORS a chamar esta API.
# Ex.: http://localhost:5173,https://chamados.suaempresa.com
FRONTEND_URLS=http://localhost:5173
